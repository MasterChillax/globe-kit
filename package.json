{
  "name": "@masterchillax/globe-kit",
  "version": "0.1.0",
  "description": "System-standard globe basemap policy: provider registry, license/key gate, stack resolver, label anchors, style lint. Pure TypeScript, no maplibre-gl dependency.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./registry": "./registry/providers.json"
