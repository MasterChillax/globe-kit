    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "selftest": "tsx scripts/selftest.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.15.0"
}
